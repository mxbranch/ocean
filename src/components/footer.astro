---
import { Image } from 'astro:assets'
import bocean from '#/assets/bocean.jpg'
import watermark from '#/assets/watermark.svg'

import Bsky from '#/components/icon/bsky.astro'
import Codeberg from '#/components/icon/codeberg.astro'
import Linkedin from '#/components/icon/linkedin.astro'
import ModeToggle from '#/components/mode-toggle.astro'

// #/styles/blocks/footer.css
---

<footer class="footer float-bottom">
  <div class="footer__waves"></div>
  <div class="container footer__content">
    <Image
      class="footer__watermark"
      src={watermark}
      alt=""
      quality="high"
      loading="lazy"
      width={256}
    />
    <Image
      class="footer__illustration"
      src={bocean}
      alt="The British seaside on a particularly nice day"
      quality="high"
      loading="lazy"
      width={800}
      layout="constrained"
      style="--footer-illustration-y: 60%;"
    />
    <div class="footer__rows">
      <div class="repel">
        <div class="footer__icons text-sm cluster">
          <span>Elsewhere:</span>
          <a
            href="https://bsky.app/profile/mxbranch.com"
            class="footer__icons__link"
            target="_blank"
          >
            <Bsky />
          </a>
          <a
            href="https://codeberg.org/mxbranch"
            class="footer__icons__link"
            target="_blank"
          >
            <Codeberg />
          </a>
          <a
            href="https://www.linkedin.com/in/d-r-branch/"
            class="footer__icons__link"
            target="_blank"
          >
            <Linkedin />
          </a>
        </div>
        <ModeToggle class="footer__icons__link" />
      </div>
      <div class="footer__text text-sm repel">
        <a href="#top">Back To Top</a>
        <a href="/colophon/">Colophon</a>
        <div>A better, more human web is possible!</div>
        <div>
          Made with 💙 on the South Coast of the UK - {new Date().getFullYear()}
        </div>
      </div>
    </div>
  </div>
</footer>
