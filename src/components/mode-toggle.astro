---
import SunMoon from './icon/sun-moon.astro'

interface Props {
  class?: string
}

const { class: propsClass } = Astro.props

// #/styles/blocks/mode-toggle.css
---

<button id="theme-toggle" class={`toggle ${propsClass}`.trim()}>
  <SunMoon />
  <span class="visually-hidden">Toggle Colour Theme</span>
</button>

<script is:inline>
  function handleToggleClick() {
    const {
      documentElement: { classList },
    } = document
    classList.toggle('dark')
    const isDark = classList.contains('dark')
    localStorage?.setItem('theme', isDark ? 'dark' : 'light')
  }

  document
    .querySelector('#theme-toggle')
    ?.addEventListener('click', handleToggleClick)
</script>
