---
// #/styles/blocks/header.css

type NavLink = {
  href: string
  label: string
}

const pathname = Astro.url.pathname

const navigationLinks: NavLink[] = [
  {
    href: '/about/',
    label: 'About',
  },
  {
    href: '/case-study/',
    label: 'Case Studies',
  },
]
---

<header class="container repel">
  <a href="/">D. R. Branch</a>
  <nav class="cluster">
    {navigationLinks.map((link) => {
      const linkIsHomepage = link.href === '/' && link.href === pathname
      const linkMatchesCurrentPath =
        link.href !== '/' && pathname.startsWith(link.href)
      const current = linkIsHomepage || linkMatchesCurrentPath || undefined
      return (
        <a href={link.href} data-current={current}>
          {link.label}
        </a>
      )
    })}
  </nav>
</header>
