---
import Bsky from '#/components/icon/bsky.astro'
import Codeberg from '#/components/icon/codeberg.astro'
import ModeToggle from '#/components/mode-toggle.astro'
// #/styles/blocks/header.css

type NavLink = {
  href: string
  label: string
}

const pathname = Astro.url.pathname

const navigationLinks: NavLink[] = [
  {
    href: '/',
    label: 'Home',
  },
  {
    href: '/about',
    label: 'About',
  },
]
---

<header class="header">
  <div class="container header__title">
    <a href="/" class="header__title__link">D. R. Branch</a>
  </div>
  <div class="container header__navbar">
    <nav class="header__nav expand">
      {
        navigationLinks.map((link) => (
          <a
            href={link.href}
            class="header__nav__link"
            data-current={pathname === link.href || undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="https://bsky.app/profile/mxbranch.bsky.social"
        class="header__nav__link float-right"
        target="_blank"
      >
        <Bsky />
      </a>
      <a
        href="https://codeberg.org/mxbranch"
        class="header__nav__link"
        target="_blank"
      >
        <Codeberg />
      </a>
    </nav>
    <div class="header__nav">
      <ModeToggle />
    </div>
  </div>
</header>
