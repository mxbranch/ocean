---
// #/styles/blocks/header.css

type NavLink = {
  href: string
  label: string
}

const pathname = Astro.url.pathname

const navigationLinks: NavLink[] = [
  {
    href: '/',
    label: 'Home',
  },
  {
    href: '/about/',
    label: 'About',
  },
]
---

<header>
  <div class="container repel | header__title">
    <a href="/" class="header__title__link">D. R. Branch</a>
    <nav class="cluster | header__nav">
      {
        navigationLinks.map((link) => (
          <a
            href={link.href}
            class="header__nav__link"
            data-current={pathname === link.href || undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
