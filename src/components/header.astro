---
// #/styles/blocks/header.css

type NavLink = {
  href: string
  label: string
}

const pathname = Astro.url.pathname

const navigationLinks: NavLink[] = [
  {
    href: '/about/',
    label: 'About',
  },
  {
    href: '/case-study/',
    label: 'Case Studies',
  },
]
---

<header>
  <div class="container repel | header__title">
    <a href="/" class="header__title__link">D. R. Branch</a>
    <nav class="cluster | header__nav">
      {
        navigationLinks.map((link) => {
          const linkIsHomepage = link.href === '/' && link.href === pathname
          const linkMatchesCurrentPath =
            link.href !== '/' && pathname.startsWith(link.href)
          const current = linkIsHomepage || linkMatchesCurrentPath || undefined
          return (
            <a
              href={link.href}
              class="header__nav__link"
              data-current={current}
            >
              {link.label}
            </a>
          )
        })
      }
    </nav>
  </div>
</header>
