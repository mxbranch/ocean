---
import Root from '#/layout/root.astro'
import CaseStudyGrid from '#/components/case-study-grid.astro'
import construction from '#/assets/underconstruction.gif'
import { Image } from 'astro:assets'
---

<Root title="Case Studies">
  <h1>Case Studies</h1>
  <CaseStudyGrid />
  <Image
    src={construction}
    alt="Under Construction"
    class="center construction"
    loading="eager"
  />
</Root>
