---
import Root from '#/layout/root.astro'
import drb from '#/assets/drb.jpg'
import construction from '#/assets/underconstruction.gif'
import { Image } from 'astro:assets'
---

<Root>
  <h1>
    Web developer who loves <span class="highlight">accessibility</span>,
    standards, and designing for <span class="highlight">humans</span>
  </h1>
  <section class="hero with-sidebar">
    <div class="flow">
      <p class="text-lg">
        Hi! 👋 I'm D. R. Branch, a web developer currently based on the South
        Coast of the UK.
      </p>
      <p>
        My priority as a developer is producing sites which are a joy to browse
        on any device. I achieve this by sweating the fundamentals, choosing the
        right tools for the job, and thinking about people.
      </p>
      <p>
        When I'm not at work shuffling bytes around you can find me living with
        my husband and our cat, playing the piano, or wandering besides the sea.
      </p>
    </div>
    <div class="sidebar flow">
      <Image class="hero__image" src={drb} alt="D. R. Branch" loading="eager" />
    </div>
  </section>
  <section class="flow">
    <h2>Project Overviews</h2>
    <Image
      src={construction}
      alt="Under Construction"
      class="center construction"
      loading="eager"
    />
  </section></Root
>
