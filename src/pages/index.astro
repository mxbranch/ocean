---
import Root from '#/layout/root.astro'
import drb from '#/assets/drb.jpg'
import vibeCheck from '#/assets/vibe-check.png'
import { Image } from 'astro:assets'
---

<Root>
  <h1>
    Web developer who loves <span class="highlight">accessibility</span>,
    standards, and designing for <span class="highlight">humans</span>
  </h1>
  <section class="hero with-sidebar">
    <div class="flow">
      <p class="text-lg">
        Hi! 👋 I'm D. R. Branch, a web developer currently based on the South
        Coast of the UK.
      </p>
      <p>
        As a developer, my aim is to produce sites which are a joy to browse on
        any device. I sweat the fundamentals, choose the right tools for the
        job, and think about people.
      </p>
      <p>
        When I'm not at work shuffling bytes around, you can find me living with
        my husband and our cat, playing the piano, or wandering besides the sea.
      </p>
    </div>
    <div class="sidebar flow">
      <Image
        class="hero__image"
        src={drb}
        width={300}
        alt="D. R. Branch"
        loading="eager"
        quality="mid"
        layout="constrained"
      />
    </div>
  </section>
  <section class="flow">
    <h2>Case Studies</h2>
    <div class="grid" data-layout="thirds">
      <article class="projectcard flow">
        <a href="/case-study/vibe-check/">
          <Image
            class="projectcard__image"
            src={vibeCheck}
            alt="Vibe Check!"
            loading="eager"
            width={300}
            quality="mid"
            layout="constrained"
          />
        </a>
        <div class="projectcard__link">
          <a href="/case-study/vibe-check/">Vibe Check!</a>
        </div>
        <p class="text-sm">
          A web-based multiplayer game designed for Twitch streamers to play
          with their chat.
        </p>
      </article>
    </div>
  </section>
</Root>
